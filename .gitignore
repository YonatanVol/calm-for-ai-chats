# macOS
.DS_Store

# Editor
.vscode/
.idea/
*.swp

# Packaged builds
dist/
*.zip
*.crx
*.pem

# Logs
*.log

# Python (bytecode caches break Chrome's unpacked-extension loader)
__pycache__/
*.pyc

# Node (web app, later)
node_modules/
.next/
.env
.env.local

# Landing page (site/). The generic rules above already match these; they are
# spelled out so nobody has to work out that a site build is never committed.
site/node_modules/
site/dist/
site/.vercel/
